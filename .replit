modules = ["nodejs-24", "python-3.11", "postgresql-16"]

    [deployment]
    router = "application"
    deploymentTarget = "vm"
    run = ["bash", "start.sh"]

    [deployment.postBuild]
    args = ["pnpm", "store", "prune"]
    env = { "CI" = "true" }

    [workflows]
    runButton = "Project"

    [[workflows.workflow]]
    name = "Project"
    mode = "parallel"
    author = "agent"

    [[workflows.workflow.tasks]]
    task = "workflow.run"
    args = "Telegram Bot"

    [[workflows.workflow]]
    name = "Telegram Bot"
    author = "agent"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "python3 telegram-bot/bot.py"

    [workflows.workflow.metadata]
    outputType = "console"

    [agent]
    stack = "PNPM_WORKSPACE"
    expertMode = true

    [postMerge]
    path = "scripts/post-merge.sh"
    timeoutMs = 20000

    [nix]
    channel = "stable-25_05"

[userenv]

[userenv.shared]
MINIAPP_URL = "https://0b280a30-161a-4a13-83ad-5e350bb266d9-00-3b1b4ioogawbn.riker.replit.dev/api/"
